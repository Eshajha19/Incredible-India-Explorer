diff --git a/tests/unit/hidden-gems-core.test.js b/tests/unit/hidden-gems-core.test.js
new file mode 100644
index 0000000..b87f6dc
--- /dev/null
+++ b/tests/unit/hidden-gems-core.test.js
@@ -0,0 +1,198 @@
+/**
+ * hidden-gems-core.test.js
+ * Tests for js-modules/hidden-gems-core.js — the pure content-quality
+ * scoring, duplicate-detection, ranking, reputation, and moderation
+ * transition logic behind the Community-Contributed Hidden Gems
+ * Discovery Platform (issue #865).
+ */
+
+import { describe, it, expect } from 'vitest';
+import Core from '../../js-modules/hidden-gems-core.js';
+import Data from '../../js-modules/hidden-gems-data.js';
+
+function submission(overrides) {
+    return Object.assign({
+        name: 'Dzukou Valley',
+        desc: 'A remote valley on the Nagaland-Manipur border famous for its seasonal wildflowers and gentle rolling hills, reached via a steep multi-hour trek from Viswema village.',
+        img: 'https://example.com/photo.jpg',
+        category: 'trek',
+        region: 'east',
+        state: 'Nagaland',
+        lat: 25.5941,
+        lng: 94.1077,
+        submittedBy: 'Test User'
+    }, overrides);
+}
+
+describe('hidden-gems-core: text similarity', () => {
+    it('gives identical text a similarity of 1', () => {
+        expect(Core.textSimilarity('Ziro Valley rice terraces', 'Ziro Valley rice terraces')).toBe(1);
+    });
+
+    it('gives completely different text a similarity near 0', () => {
