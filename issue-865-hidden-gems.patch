+describe('hidden-gems-core: computeRankScore / rankGems / trendingGems', () => {
+    const now = new Date('2026-07-01T00:00:00.000Z');
+
+    it('ranks a higher-quality, more-upvoted gem above a lower one', () => {
+        const strong = { id: 'a', qualityScore: 90, upvotes: 20, bookmarkCount: 5, approvedAt: now.toISOString(), status: Data.SUBMISSION_STATUS.APPROVED };
+        const weak = { id: 'b', qualityScore: 50, upvotes: 1, bookmarkCount: 0, approvedAt: now.toISOString(), status: Data.SUBMISSION_STATUS.APPROVED };
+        expect(Core.computeRankScore(strong, Data, now)).toBeGreaterThan(Core.computeRankScore(weak, Data, now));
+    });
+
+    it('decays engagement score for older gems relative to a fresher one with equal stats', () => {
+        const fresh = { id: 'a', qualityScore: 70, upvotes: 10, bookmarkCount: 2, approvedAt: now.toISOString() };
+        const old = { id: 'b', qualityScore: 70, upvotes: 10, bookmarkCount: 2, approvedAt: new Date('2026-01-01T00:00:00.000Z').toISOString() };
+        expect(Core.computeRankScore(fresh, Data, now)).toBeGreaterThan(Core.computeRankScore(old, Data, now));
+    });
+
+    it('rankGems sorts descending by rank score', () => {
+        const gems = [
+            { id: 'low', qualityScore: 40, upvotes: 0, bookmarkCount: 0, approvedAt: now.toISOString() },
+            { id: 'high', qualityScore: 95, upvotes: 30, bookmarkCount: 10, approvedAt: now.toISOString() }
+        ];
+        const ranked = Core.rankGems(gems, Data, now);
+        expect(ranked[0].id).toBe('high');
+    });
+
+    it('trendingGems only includes approved gems', () => {
+        const gems = [
+            { id: 'a', qualityScore: 90, upvotes: 10, bookmarkCount: 1, approvedAt: now.toISOString(), status: Data.SUBMISSION_STATUS.APPROVED },
+            { id: 'b', qualityScore: 99, upvotes: 50, bookmarkCount: 20, approvedAt: now.toISOString(), status: Data.SUBMISSION_STATUS.PENDING }
+        ];
+        const trending = Core.trendingGems(gems, Data, 6, now);
+        expect(trending.map((g) => g.id)).toEqual(['a']);
+    });
+});
