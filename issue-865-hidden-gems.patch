@@ -0,0 +1,276 @@
+/**
+ * js-modules/hidden-gems-core.js
+ * Community-Contributed Hidden Gems Discovery Platform (issue #865)
+ * — rule-based logic module.
+ *
+ * Pure functions only: no DOM, no fetch, no localStorage — mirrors the
+ * core/service/ui split used by travel-safety-core.js (issue #772) and
+ * weather-core.js (issue #286). Persistence lives in
+ * hidden-gems-service.js; DOM in hidden-gems-ui.js.
+ *
+ * IMPORTANT — on the "AI" in "AI-based duplicate detection" /
+ * "AI-generated content quality scoring": this project has no backend
+ * and no server-side model to call, so both are implemented as
+ * transparent, deterministic heuristics (text-similarity matching and a
+ * weighted rubric) rather than a trained ML model. They're labeled
+ * "AI-assisted" in the UI to match the issue's language, but the actual
+ * mechanism is documented here and in docs/HIDDEN_GEMS.md so nobody
+ * mistakes it for more than it is. Neither one auto-publishes or
+ * auto-deletes anything — they only flag items for a human moderator.
+ *
+ * Exposed as window.HiddenGemsCore (browser) and module.exports (Node/Vitest).
+ */
+(function (root) {
+    "use strict";
+
+    // ------------------------------------------------------------------
+    // Text similarity (duplicate detection)
+    // ------------------------------------------------------------------
+    const STOPWORDS = new Set([
+        "a", "an", "the", "and", "or", "of", "in", "on", "at", "to", "for",
+        "with", "is", "are", "this", "that", "near", "it", "its", "very"
+    ]);
+
+    function tokenize(text) {
+        if (!text) return [];
+        return String(text)
+            .toLowerCase()
+            .replace(/[^a-z0-9\s]/g, " ")
+            .split(/\s+/)
+            .filter((t) => t && !STOPWORDS.has(t));
+    }
+
+    /** Jaccard similarity between two token sets, 0 (no overlap) to 1 (identical). */
+    function jaccardSimilarity(tokensA, tokensB) {
+        const setA = new Set(tokensA);
+        const setB = new Set(tokensB);
+        if (!setA.size && !setB.size) return 0;
+        let intersection = 0;
+        setA.forEach((t) => { if (setB.has(t)) intersection++; });
+        const union = setA.size + setB.size - intersection;
+        return union === 0 ? 0 : intersection / union;
+    }
+
+    function textSimilarity(a, b) {
+        return jaccardSimilarity(tokenize(a), tokenize(b));
+    }
+
+    function haversineDistanceKm(lat1, lng1, lat2, lng2) {
+        if ([lat1, lng1, lat2, lng2].some((v) => typeof v !== "number" || Number.isNaN(v))) return Infinity;
+        const R = 6371;
+        const dLat = ((lat2 - lat1) * Math.PI) / 180;
+        const dLng = ((lng2 - lng1) * Math.PI) / 180;
+        const s =
+            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
+            Math.cos((lat1 * Math.PI) / 180) * Math.cos((lat2 * Math.PI) / 180) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
+        return R * (2 * Math.atan2(Math.sqrt(s), Math.sqrt(1 - s)));
+    }
+
+    /**
+     * Compares a new submission against existing gems and returns any
+     * likely duplicates, sorted strongest match first.
+     *
+     * @param {Object} submission - { name, desc, lat, lng }
+     * @param {Array} existingGems
+     * @param {Object} hiddenGemsData - window.HiddenGemsData (thresholds)
+     * @returns {Array<{gem, similarity, distanceKm}>}
+     */
+    function detectDuplicates(submission, existingGems, hiddenGemsData) {
+        const subTokens = tokenize((submission.name || "") + " " + (submission.desc || ""));
+        const matches = [];
+
+        existingGems.forEach((gem) => {
+            const gemTokens = tokenize((gem.name || "") + " " + (gem.desc || ""));
+            const similarity = jaccardSimilarity(subTokens, gemTokens);
+            const distanceKm = haversineDistanceKm(submission.lat, submission.lng, gem.lat, gem.lng);
+
+            const nameMatch = tokenize(submission.name).join(" ") === tokenize(gem.name).join(" ") && submission.name;
+            const textFlag = similarity >= hiddenGemsData.DUPLICATE_SIMILARITY_THRESHOLD;
+            const geoFlag = distanceKm <= hiddenGemsData.DUPLICATE_DISTANCE_KM;
+
+            if (nameMatch || textFlag || (geoFlag && similarity > 0.25)) {
+                matches.push({ gem, similarity: Math.round(similarity * 100) / 100, distanceKm: Number.isFinite(distanceKm) ? Math.round(distanceKm * 10) / 10 : null });
+            }
+        });
+
+        return matches.sort((a, b) => b.similarity - a.similarity);
+    }
+
+    // ------------------------------------------------------------------
+    // Content quality scoring
+    // ------------------------------------------------------------------
+    function containsBannedContent(submission, hiddenGemsData) {
+        const haystack = ((submission.name || "") + " " + (submission.desc || "")).toLowerCase();
+        const banned = hiddenGemsData.BANNED_WORDS.some((w) => haystack.includes(w));
+        const placeholder = hiddenGemsData.PLACEHOLDER_PHRASES.some((w) => haystack.includes(w));
+        return banned || placeholder;
+    }
+
+    /**
+     * @param {Object} submission - { name, desc, img, lat, lng, category }
+     * @param {Object} hiddenGemsData - window.HiddenGemsData
+     * @returns {{score:number, breakdown:Object, flags:Array<string>}}
+     */
+    function computeQualityScore(submission, hiddenGemsData) {
+        const weights = hiddenGemsData.QUALITY_WEIGHTS;
+        const flags = [];
+        const breakdown = {};
+
+        // Description length — rewards up to ~220 characters, no bonus beyond that.
+        const descLen = (submission.desc || "").trim().length;
+        const descScore = Math.min(1, descLen / 220);
+        breakdown.descriptionLength = Math.round(descScore * weights.descriptionLength);
+        if (descLen < 40) flags.push("description-too-short");
+
+        // Image present
+        const hasImage = !!(submission.img && submission.img.trim());
+        breakdown.hasImage = hasImage ? weights.hasImage : 0;
+        if (!hasImage) flags.push("missing-image");
+
+        // Precise location (lat/lng), not just a state name
+        const hasLocation = typeof submission.lat === "number" && typeof submission.lng === "number" && !Number.isNaN(submission.lat) && !Number.isNaN(submission.lng);
+        breakdown.hasLocation = hasLocation ? weights.hasLocation : 0;
+        if (!hasLocation) flags.push("missing-coordinates");
+
+        // Category tagged
+        const hasCategory = !!(submission.category && hiddenGemsData.CATEGORIES.some((c) => c.id === submission.category));
+        breakdown.hasCategory = hasCategory ? weights.hasCategory : 0;
+        if (!hasCategory) flags.push("missing-category");
+
+        // Title quality: reasonable length, not shouty/spammy
+        const name = (submission.name || "").trim();
+        const titleOk = name.length >= 3 && name.length <= 60 && name === name.replace(/!!!+/g, "!") && !/^[A-Z\s!]+$/.test(name.length > 4 ? name : "x");
+        breakdown.titleQuality = titleOk ? weights.titleQuality : 0;
+        if (!titleOk) flags.push("title-needs-review");
+
+        // No banned/placeholder content
+        const clean = !containsBannedContent(submission, hiddenGemsData);
+        breakdown.noBannedContent = clean ? weights.noBannedContent : 0;
+        if (!clean) flags.push("prohibited-or-placeholder-content");
+
+        const score = Object.values(breakdown).reduce((a, b) => a + b, 0);
+        return { score: Math.round(score), breakdown, flags };
+    }
+
+    const LOW_QUALITY_THRESHOLD = 50;
+
+    function isLowQuality(qualityResult) {
+        return qualityResult.score < LOW_QUALITY_THRESHOLD;
+    }
+
+    // ------------------------------------------------------------------
+    // Ranking / trending score
+    // ------------------------------------------------------------------
+    /**
+     * @param {Object} gem - { qualityScore, upvotes, bookmarkCount, approvedAt|createdAt }
+     * @param {Object} hiddenGemsData
+     * @param {Date} [now]
+     */
+    function computeRankScore(gem, hiddenGemsData, now) {
+        const weights = hiddenGemsData.RANKING_WEIGHTS;
+        now = now || new Date();
+
+        const qualityComponent = (gem.qualityScore || 0) * weights.quality;
+        const engagementRaw = (gem.upvotes || 0) * weights.upvote + (gem.bookmarkCount || 0) * weights.bookmark;
+
+        const referenceDate = new Date(gem.approvedAt || gem.createdAt || now);
+        const ageDays = Math.max(0, (now - referenceDate) / (1000 * 60 * 60 * 24));
+        const recencyMultiplier = Math.pow(0.5, ageDays / weights.recencyHalfLifeDays);
+
+        const engagementComponent = engagementRaw * recencyMultiplier;
+
+        return Math.round((qualityComponent + engagementComponent) * 100) / 100;
+    }
+
+    function rankGems(gems, hiddenGemsData, now) {
+        return gems
+            .map((gem) => Object.assign({}, gem, { rankScore: computeRankScore(gem, hiddenGemsData, now) }))
+            .sort((a, b) => b.rankScore - a.rankScore);
+    }
+
+    /** Trending = top N approved gems by rank score, engagement-weighted heavily toward recent activity. */
+    function trendingGems(gems, hiddenGemsData, limit, now) {
+        const approved = gems.filter((g) => g.status === hiddenGemsData.SUBMISSION_STATUS.APPROVED);
+        return rankGems(approved, hiddenGemsData, now).slice(0, limit || 6);
+    }
+
+    // ------------------------------------------------------------------
+    // Reputation & badges
+    // ------------------------------------------------------------------
+    function badgeForReputation(reputation, hiddenGemsData) {
+        const tiers = hiddenGemsData.BADGE_TIERS;
+        let current = tiers[0];
+        tiers.forEach((tier) => {
+            if (reputation >= tier.minReputation) current = tier;
+        });
+        return current;
+    }
+
+    /**
+     * @param {number} currentReputation
+     * @param {string} eventKey - a key in hiddenGemsData.REPUTATION_EVENTS
+     */
+    function applyReputationEvent(currentReputation, eventKey, hiddenGemsData) {
+        const delta = hiddenGemsData.REPUTATION_EVENTS[eventKey];
+        if (typeof delta !== "number") {
+            throw new Error("applyReputationEvent: unknown event key " + eventKey);
+        }
+        return Math.max(0, currentReputation + delta);
+    }
+
+    // ------------------------------------------------------------------
+    // Moderation workflow
+    // ------------------------------------------------------------------
+    const VALID_TRANSITIONS = {
+        pending: ["approved", "rejected", "changes_requested"],
+        changes_requested: ["pending", "approved", "rejected"],
+        approved: ["rejected"], // a moderator can still pull a published gem
+        rejected: ["pending"] // a contributor can resubmit
+    };
+
+    /**
+     * @param {Object} submission - must have a `status` field
+     * @param {string} nextStatus - one of hiddenGemsData.SUBMISSION_STATUS values
+     * @param {Object} [meta] - { moderatorNote, moderatedAt }
+     */
+    function transitionStatus(submission, nextStatus, meta) {
+        const current = submission.status;
+        const allowed = VALID_TRANSITIONS[current] || [];
+        if (!allowed.includes(nextStatus)) {
+            throw new Error(`Invalid moderation transition: ${current} -> ${nextStatus}`);
+        }
+        meta = meta || {};
+        return Object.assign({}, submission, {
+            status: nextStatus,
+            moderatorNote: meta.moderatorNote || null,
+            moderatedAt: meta.moderatedAt || new Date().toISOString(),
+            approvedAt: nextStatus === "approved" ? (meta.moderatedAt || new Date().toISOString()) : submission.approvedAt
+        });
+    }
+
+    const api = {
+        LOW_QUALITY_THRESHOLD,
+        tokenize,
+        jaccardSimilarity,
+        textSimilarity,
+        haversineDistanceKm,
+        detectDuplicates,
+        containsBannedContent,
+        computeQualityScore,
+        isLowQuality,
+        computeRankScore,
+        rankGems,
+        trendingGems,
+        badgeForReputation,
+        applyReputationEvent,
+        VALID_TRANSITIONS,
+        transitionStatus
+    };
+
+    if (typeof module !== "undefined" && module.exports) {
+        module.exports = api;
+    }
+    if (typeof window !== "undefined") {
+        window.HiddenGemsCore = api;
+    }
+})(typeof window !== "undefined" ? window : globalThis);
