+/**
+ * js-modules/hidden-gems-data.js
+ * Config + seed data for the Community-Contributed Hidden Gems Discovery
+ * Platform (issue #865).
+ *
+ * The original hidden-gems.html page shipped with 8 hardcoded
+ * destinations. Those are preserved here as pre-approved seed entries
+ * (status: 'approved', source: 'editorial') so the page isn't empty on
+ * first load, and so community submissions render in the same grid
+ * alongside them.
+ */
+(function (root) {
+    "use strict";
+
+    // ------------------------------------------------------------------
+    // Categories a submission can be tagged with.
+    // ------------------------------------------------------------------
+    const CATEGORIES = [
+        { id: "viewpoint", label: "Viewpoint", icon: "🏔️" },
+        { id: "cafe", label: "Café / Local Eatery", icon: "☕" },
+        { id: "trek", label: "Trekking Route", icon: "🥾" },
+        { id: "waterfall", label: "Waterfall", icon: "💧" },
+        { id: "cultural", label: "Cultural / Heritage Spot", icon: "🏛️" },
+        { id: "village", label: "Village / Offbeat Town", icon: "🏘️" },
+        { id: "nature", label: "Nature / Wildlife Spot", icon: "🌿" },
+        { id: "other", label: "Other", icon: "📍" }
+    ];
+
+    const REGIONS = [
+        { id: "north", label: "North" },
+        { id: "south", label: "South" },
+        { id: "east", label: "East & Northeast" },
+        { id: "west", label: "West" },
+        { id: "central", label: "Central" }
+    ];
+
+    // ------------------------------------------------------------------
+    // Moderation statuses a submission can be in.
+    // ------------------------------------------------------------------
+    const SUBMISSION_STATUS = {
+        PENDING: "pending",
+        APPROVED: "approved",
+        REJECTED: "rejected",
+        CHANGES_REQUESTED: "changes_requested"
+    };
+
+    // ------------------------------------------------------------------
+    // Content-quality scoring weights (see hidden-gems-core.js for the
+    // scoring function itself). Kept here so the weights are easy to
+    // tune without touching logic.
+    // ------------------------------------------------------------------
+    const QUALITY_WEIGHTS = {
+        descriptionLength: 30, // rewards a substantive, non-trivial description
+        hasImage: 15,
+        hasLocation: 15, // lat/lng provided, not just a state name
+        hasCategory: 10,
+        titleQuality: 10, // reasonable title length, not all-caps/spammy
+        noBannedContent: 20 // penalize spammy/placeholder/prohibited content
+    };
+
+    // Very small, generic prohibited-content check — this is a basic
+    // safety net, not a real content-moderation model. Anything flagged
+    // still goes to a human moderator; nothing is auto-published or
+    // auto-deleted based on this alone.
+    const BANNED_WORDS = ["viagra", "crypto giveaway", "click here now", "free money", "xxx"];
+    const PLACEHOLDER_PHRASES = ["lorem ipsum", "test test", "asdf", "n/a", "todo"];
+
+    // ------------------------------------------------------------------
+    // Reputation / badge tiers, keyed by cumulative reputation points.
+    // ------------------------------------------------------------------
+    const REPUTATION_EVENTS = {
+        SUBMISSION_APPROVED: 15,
+        SUBMISSION_REJECTED: -3,
+        RECEIVED_UPVOTE: 1,
+        SUBMISSION_REPORTED_VALID: -10 // a moderator upholds a report against the contributor's gem
+    };
+
+    const BADGE_TIERS = [
+        { id: "newcomer", label: "Newcomer", minReputation: 0, icon: "🌱" },
+        { id: "explorer", label: "Explorer", minReputation: 20, icon: "🧭" },
+        { id: "pathfinder", label: "Pathfinder", minReputation: 60, icon: "🗺️" },
+        { id: "trailblazer", label: "Trailblazer", minReputation: 150, icon: "🔥" },
+        { id: "legend", label: "Local Legend", minReputation: 400, icon: "🏆" }
+    ];
+
+    // ------------------------------------------------------------------
+    // Ranking weights — how quality score vs. engagement vs. recency
+    // combine into the trending/rank score. See
+    // hidden-gems-core.js#computeRankScore.
+    // ------------------------------------------------------------------
+    const RANKING_WEIGHTS = {
+        quality: 0.5, // weight applied to the 0-100 quality score
+        upvote: 3, // points per upvote
+        bookmark: 1, // points per bookmark
+        recencyHalfLifeDays: 21 // engagement/recency boost halves every N days
+    };
+
+    // Similarity threshold above which a new submission is flagged as a
+    // likely duplicate of an existing gem (see hidden-gems-core.js).
+    const DUPLICATE_SIMILARITY_THRESHOLD = 0.6;
+    const DUPLICATE_DISTANCE_KM = 2; // gems within this distance + similar text are flagged
+
+    // ------------------------------------------------------------------
+    // Seed data — the original editorial hidden gems, now modeled with
+    // the same shape as a community submission so both render through
+    // one code path.
+    // ------------------------------------------------------------------
+    const SEED_GEMS = [
+        { id: "seed-1", name: "Ziro Valley", state: "Arunachal Pradesh", region: "east", category: "nature", img: "https://picsum.photos/seed/ziro-valley/600/400", desc: "Mesmerizing rice terraces and Apatani tribal culture.", lat: 27.5921, lng: 93.8317 },
+        { id: "seed-2", name: "Majuli Island", state: "Assam", region: "east", category: "cultural", img: "https://picsum.photos/seed/majuli-island/600/400", desc: "World's largest river island and Vaishnavite culture.", lat: 27.0230, lng: 94.2140 },
+        { id: "seed-3", name: "Spiti Valley", state: "Himachal Pradesh", region: "north", category: "nature", img: "https://picsum.photos/seed/spiti-valley/600/400", desc: "Cold desert with ancient monasteries.", lat: 32.2461, lng: 78.0092 },
+        { id: "seed-4", name: "Gokarna", state: "Karnataka", region: "south", category: "nature", img: "https://picsum.photos/seed/gokarna-beach/600/400", desc: "Serene beaches and sacred temples.", lat: 14.5479, lng: 74.3188 },
+        { id: "seed-5", name: "Kutch Rann", state: "Gujarat", region: "west", category: "viewpoint", img: "https://picsum.photos/seed/white-desert/600/400", desc: "Magical white salt desert.", lat: 23.7337, lng: 69.8597 },
+        { id: "seed-6", name: "Lonar Lake", state: "Maharashtra", region: "west", category: "nature", img: "https://picsum.photos/seed/lonar-lake/600/400", desc: "Mysterious meteor crater lake.", lat: 19.9807, lng: 76.5111 },
+        { id: "seed-7", name: "Tawang", state: "Arunachal Pradesh", region: "east", category: "cultural", img: "https://picsum.photos/seed/tawang-monastery/600/400", desc: "Ancient monastery and breathtaking Himalayan views.", lat: 27.5860, lng: 91.8594 },
+        { id: "seed-8", name: "Nelliyampathy", state: "Kerala", region: "south", category: "trek", img: "https://picsum.photos/seed/kerala-hills/600/400", desc: "Hidden hill station with tea plantations.", lat: 10.5167, lng: 76.6667 }
+    ].map((g) => Object.assign({}, g, {
+        status: SUBMISSION_STATUS.APPROVED,
+        source: "editorial",
+        submittedBy: "Incredible India Explorer Team",
+        createdAt: "2026-01-01T00:00:00.000Z",
+        approvedAt: "2026-01-01T00:00:00.000Z",
+        qualityScore: 100,
+        upvotes: 0,
+        bookmarkCount: 0,
+        reports: []
+    }));
+
+    const api = {
+        CATEGORIES,
+        REGIONS,
+        SUBMISSION_STATUS,
+        QUALITY_WEIGHTS,
+        BANNED_WORDS,
+        PLACEHOLDER_PHRASES,
+        REPUTATION_EVENTS,
+        BADGE_TIERS,
+        RANKING_WEIGHTS,
+        DUPLICATE_SIMILARITY_THRESHOLD,
+        DUPLICATE_DISTANCE_KM,
+        SEED_GEMS
+    };
+
+    if (typeof module !== "undefined" && module.exports) {
+        module.exports = api;
+    }
+    if (typeof window !== "undefined") {
+        window.HiddenGemsData = api;
+    }
+})(typeof window !== "undefined" ? window : globalThis);
