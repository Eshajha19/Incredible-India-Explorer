+++ b/js-modules/hidden-gems-service.js
@@ -0,0 +1,299 @@
+/**
+ * js-modules/hidden-gems-service.js
+ * Persistence layer for the Community-Contributed Hidden Gems Discovery
+ * Platform (issue #865).
+ *
+ * This project has no backend (see docs/TRAVEL_SAFETY.md and
+ * docs/TRIP_PLANNER.md for the same pattern used elsewhere), so
+ * "Community contribution service" / "Backend APIs for submissions and
+ * moderation" / "Reputation management system" are all implemented as a
+ * localStorage-backed service layer, scoped to one browser. That's a
+ * real, documented limitation — see docs/HIDDEN_GEMS.md — not a hidden
+ * shortcut: submissions, votes, and reputation don't sync across
+ * devices or contributors without a real backend, which is a natural
+ * follow-up once this repo has one.
+ *
+ * Contributors are identified by a display name they type in (no
+ * account system beyond the site's existing optional Firebase login),
+ * plus an anonymous per-browser voter id so the same browser can't
+ * upvote a gem twice.
+ */
+(function (root) {
+    "use strict";
+
+    const KEYS = {
+        submissions: "hiddenGemsSubmissions",
+        contributors: "hiddenGemsContributors",
+        votes: "hiddenGemsVotes", // { [gemId]: [voterId, ...] }
+        bookmarks: "hiddenGemsBookmarks", // [gemId, ...] for this browser
+        reports: "hiddenGemsReports",
+        voterId: "hiddenGemsVoterId",
+        moderatorMode: "hiddenGemsModeratorMode"
+    };
+
+    function readJSON(key, fallback) {
+        try {
+            const raw = localStorage.getItem(key);
+            return raw ? JSON.parse(raw) : fallback;
+        } catch (e) {
+            return fallback;
+        }
+    }
+
+    function writeJSON(key, value) {
+        try {
+            localStorage.setItem(key, JSON.stringify(value));
+            return true;
+        } catch (e) {
+            return false;
+        }
+    }
+
+    function uid(prefix) {
+        return `${prefix}-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
+    }
+
+    function getVoterId() {
+        let id = localStorage.getItem(KEYS.voterId);
+        if (!id) {
+            id = uid("voter");
+            localStorage.setItem(KEYS.voterId, id);
+        }
+        return id;
+    }
+
+    // ------------------------------------------------------------------
+    // Submissions
+    // ------------------------------------------------------------------
+    function getAllSubmissions() {
+        return readJSON(KEYS.submissions, []);
+    }
+
+    function saveAllSubmissions(list) {
+        return writeJSON(KEYS.submissions, list);
+    }
+
+    /** Approved seed gems + approved community submissions, for the public grid. */
+    function getPublishedGems(hiddenGemsData) {
+        const approved = getAllSubmissions().filter((s) => s.status === hiddenGemsData.SUBMISSION_STATUS.APPROVED);
+        return hiddenGemsData.SEED_GEMS.concat(approved);
+    }
+
+    /** Every gem, published or not — used for duplicate-checking new submissions. */
+    function getAllGemsForDuplicateCheck(hiddenGemsData) {
+        return hiddenGemsData.SEED_GEMS.concat(getAllSubmissions());
+    }
+
+    /**
+     * Create a new submission: runs quality scoring + duplicate
+     * detection (via hiddenGemsCore), stores it as 'pending', and
+     * records the contributor.
+     *
+     * @param {Object} formData - { name, desc, img, category, region, state, lat, lng, submittedBy }
+     * @returns {{ submission, qualityResult, duplicates }}
+     */
+    function submitGem(formData, hiddenGemsCore, hiddenGemsData) {
+        const qualityResult = hiddenGemsCore.computeQualityScore(formData, hiddenGemsData);
+        const duplicates = hiddenGemsCore.detectDuplicates(formData, getAllGemsForDuplicateCheck(hiddenGemsData), hiddenGemsData);
+
+        const submission = Object.assign({}, formData, {
+            id: uid("gem"),
+            status: hiddenGemsData.SUBMISSION_STATUS.PENDING,
+            source: "community",
+            createdAt: new Date().toISOString(),
+            approvedAt: null,
+            qualityScore: qualityResult.score,
+            qualityFlags: qualityResult.flags,
+            duplicateOf: duplicates.length ? duplicates[0].gem.id : null,
+            upvotes: 0,
+            bookmarkCount: 0,
+            reports: []
+        });
+
+        const all = getAllSubmissions();
+        all.push(submission);
+        saveAllSubmissions(all);
+        ensureContributor(formData.submittedBy).submissionCount++;
+        persistContributors();
+
+        return { submission, qualityResult, duplicates };
+    }
+
+    /**
+     * Moderator action on a pending/changes-requested submission.
+     * @param {string} submissionId
+     * @param {string} nextStatus - hiddenGemsData.SUBMISSION_STATUS value
+     * @param {string} [note]
+     */
+    function moderateSubmission(submissionId, nextStatus, note, hiddenGemsCore, hiddenGemsData) {
+        const all = getAllSubmissions();
+        const idx = all.findIndex((s) => s.id === submissionId);
+        if (idx === -1) throw new Error("Submission not found: " + submissionId);
+
+        const updated = hiddenGemsCore.transitionStatus(all[idx], nextStatus, { moderatorNote: note });
+        all[idx] = updated;
+        saveAllSubmissions(all);
+
+        const contributor = ensureContributor(updated.submittedBy);
+        if (nextStatus === hiddenGemsData.SUBMISSION_STATUS.APPROVED) {
+            contributor.reputation = hiddenGemsCore.applyReputationEvent(contributor.reputation, "SUBMISSION_APPROVED", hiddenGemsData);
+        } else if (nextStatus === hiddenGemsData.SUBMISSION_STATUS.REJECTED) {
+            contributor.reputation = hiddenGemsCore.applyReputationEvent(contributor.reputation, "SUBMISSION_REJECTED", hiddenGemsData);
+        }
+        persistContributors();
+
+        return updated;
+    }
+
+    // ------------------------------------------------------------------
+    // Contributors / reputation
+    // ------------------------------------------------------------------
+    let _contributorsCache = null;
+
+    function loadContributors() {
+        if (!_contributorsCache) {
+            _contributorsCache = readJSON(KEYS.contributors, {});
+        }
+        return _contributorsCache;
+    }
+
+    function persistContributors() {
+        writeJSON(KEYS.contributors, _contributorsCache || {});
+    }
+
+    function ensureContributor(name) {
+        const key = (name || "Anonymous Explorer").trim() || "Anonymous Explorer";
+        const contributors = loadContributors();
+        if (!contributors[key]) {
+            contributors[key] = { name: key, reputation: 0, submissionCount: 0, joinedAt: new Date().toISOString() };
+        }
+        return contributors[key];
+    }
+
+    function getContributor(name) {
+        return loadContributors()[(name || "").trim()] || null;
+    }
+
+    function getLeaderboard(hiddenGemsCore, hiddenGemsData, limit) {
+        const contributors = Object.values(loadContributors());
+        return contributors
+            .map((c) => Object.assign({}, c, { badge: hiddenGemsCore.badgeForReputation(c.reputation, hiddenGemsData) }))
+            .sort((a, b) => b.reputation - a.reputation)
+            .slice(0, limit || 10);
+    }
+
+    // ------------------------------------------------------------------
+    // Upvotes / bookmarks / reports
+    // ------------------------------------------------------------------
+    function toggleUpvote(gemId, hiddenGemsCore, hiddenGemsData) {
+        const votes = readJSON(KEYS.votes, {});
+        const voterId = getVoterId();
+        const voters = votes[gemId] || [];
+        const alreadyVoted = voters.includes(voterId);
+
+        votes[gemId] = alreadyVoted ? voters.filter((v) => v !== voterId) : voters.concat(voterId);
+        writeJSON(KEYS.votes, votes);
+
+        const delta = alreadyVoted ? -1 : 1;
+        const submissions = getAllSubmissions();
+        const idx = submissions.findIndex((s) => s.id === gemId);
+        if (idx !== -1) {
+            submissions[idx] = Object.assign({}, submissions[idx], { upvotes: Math.max(0, (submissions[idx].upvotes || 0) + delta) });
+            saveAllSubmissions(submissions);
+            if (!alreadyVoted && submissions[idx].submittedBy) {
+                const contributor = ensureContributor(submissions[idx].submittedBy);
+                contributor.reputation = hiddenGemsCore.applyReputationEvent(contributor.reputation, "RECEIVED_UPVOTE", hiddenGemsData);
+                persistContributors();
+            }
+        }
+        return { upvoted: !alreadyVoted, count: (votes[gemId] || []).length };
+    }
+
+    function hasUpvoted(gemId) {
+        const votes = readJSON(KEYS.votes, {});
+        return (votes[gemId] || []).includes(getVoterId());
+    }
+
+    function toggleBookmark(gemId) {
+        const bookmarks = readJSON(KEYS.bookmarks, []);
+        const has = bookmarks.includes(gemId);
+        const next = has ? bookmarks.filter((id) => id !== gemId) : bookmarks.concat(gemId);
+        writeJSON(KEYS.bookmarks, next);
+
+        const submissions = getAllSubmissions();
+        const idx = submissions.findIndex((s) => s.id === gemId);
+        if (idx !== -1) {
+            const delta = has ? -1 : 1;
+            submissions[idx] = Object.assign({}, submissions[idx], { bookmarkCount: Math.max(0, (submissions[idx].bookmarkCount || 0) + delta) });
+            saveAllSubmissions(submissions);
+        }
+        return !has;
+    }
+
+    function isBookmarked(gemId) {
+        return readJSON(KEYS.bookmarks, []).includes(gemId);
+    }
+
+    function getBookmarks() {
+        return readJSON(KEYS.bookmarks, []);
+    }
+
+    function reportGem(gemId, reason, note) {
+        const reports = readJSON(KEYS.reports, []);
+        const report = { id: uid("report"), gemId, reason, note: note || "", createdAt: new Date().toISOString(), status: "open" };
+        reports.push(report);
+        writeJSON(KEYS.reports, reports);
+        return report;
+    }
+
+    function getReportsForGem(gemId) {
+        return readJSON(KEYS.reports, []).filter((r) => r.gemId === gemId);
+    }
+
+    function getAllReports() {
+        return readJSON(KEYS.reports, []);
+    }
+
+    // ------------------------------------------------------------------
+    // Moderator mode (local placeholder — see docs/HIDDEN_GEMS.md for
+    // why this isn't wired to real role-based auth yet)
+    // ------------------------------------------------------------------
+    function isModeratorMode() {
+        return readJSON(KEYS.moderatorMode, false) === true;
+    }
+
+    function setModeratorMode(enabled) {
+        writeJSON(KEYS.moderatorMode, !!enabled);
+    }
+
+    const api = {
+        KEYS,
+        getVoterId,
+        getAllSubmissions,
+        saveAllSubmissions,
+        getPublishedGems,
+        getAllGemsForDuplicateCheck,
+        submitGem,
+        moderateSubmission,
+        ensureContributor,
+        getContributor,
+        getLeaderboard,
+        toggleUpvote,
+        hasUpvoted,
+        toggleBookmark,
+        isBookmarked,
+        getBookmarks,
+        reportGem,
+        getReportsForGem,
+        getAllReports,
+        isModeratorMode,
+        setModeratorMode
+    };
+
+    if (typeof module !== "undefined" && module.exports) {
+        module.exports = api;
+    }
+    if (typeof window !== "undefined") {
+        window.HiddenGemsService = api;
+    }
+})(typeof window !== "undefined" ? window : globalThis);
diff --git a/js-modules/hidden-gems-ui.js b/js-modules/hidden-gems-ui.js
new file mode 100644
index 0000000..7b820cd
--- /dev/null
+++ b/js-modules/hidden-gems-ui.js
@@ -0,0 +1,332 @@
+/**
+ * js-modules/hidden-gems-ui.js
+ * DOM layer for the Community-Contributed Hidden Gems Discovery Platform
+ * (frontend/hidden-gems/hidden-gems.html, issue #865).
+ *
+ * Wires together hidden-gems-data.js (config/seed data),
+ * hidden-gems-core.js (pure scoring/duplicate/ranking/reputation/
+ * moderation logic), and hidden-gems-service.js (localStorage
+ * persistence) into the page. Registered in router-init.js for
+ * hidden-gems.html, called as initHiddenGemsPage().
+ */
+(function () {
+    "use strict";
+
+    function initHiddenGemsPage() {
+        const Data = window.HiddenGemsData;
+        const Core = window.HiddenGemsCore;
+        const Service = window.HiddenGemsService;
+
+        if (!Data || !Core || !Service) {
+            console.error("[HiddenGemsUI] Missing dependency (HiddenGemsData/HiddenGemsCore/HiddenGemsService) — hidden gems page disabled.");
+            return;
+        }
+
+        // -- DOM refs ------------------------------------------------------
+        const grid = document.getElementById("gemsGrid");
+        const emptyState = document.getElementById("gemsEmptyState");
+        const searchInput = document.getElementById("searchInput");
+        const filterButtons = document.querySelectorAll(".filter-btn");
+        const trendingGrid = document.getElementById("trendingGrid");
+        const leaderboardList = document.getElementById("leaderboardList");
+
+        const form = document.getElementById("gemSubmitForm");
+        const submitResultPanel = document.getElementById("gemSubmitResult");
+
+        const moderatorToggleBtn = document.getElementById("moderatorModeToggle");
+        const moderationSection = document.getElementById("moderationSection");
+        const moderationQueue = document.getElementById("moderationQueue");
+
+        if (!grid) return; // markup not present — nothing to wire up
+
+        let currentRegion = "all";
+        let currentSearch = "";
+
+        // -- Populate category select --------------------------------------
+        const categorySelect = document.getElementById("gemCategoryInput");
+        if (categorySelect) {
+            Data.CATEGORIES.forEach((c) => {
+                const opt = document.createElement("option");
+                opt.value = c.id;
+                opt.textContent = `${c.icon} ${c.label}`;
+                categorySelect.appendChild(opt);
+            });
+        }
+
+        // -- Rendering: gem grid --------------------------------------------
+        function getFilteredGems() {
+            const published = Service.getPublishedGems(Data);
+            const ranked = Core.rankGems(published, Data);
+            return ranked.filter((g) => {
+                const regionOk = currentRegion === "all" || g.region === currentRegion;
+                const term = currentSearch.toLowerCase();
+                const searchOk = !term || [g.name, g.state, g.desc].some((f) => (f || "").toLowerCase().includes(term));
+                return regionOk && searchOk;
+            });
+        }
+
+        function categoryMeta(id) {
+            return Data.CATEGORIES.find((c) => c.id === id) || Data.CATEGORIES[Data.CATEGORIES.length - 1];
+        }
+
+        function renderGemCard(gem) {
+            const isBookmarked = Service.isBookmarked(gem.id);
+            const isUpvoted = Service.hasUpvoted(gem.id);
+            const cat = categoryMeta(gem.category);
+            const contributor = gem.source === "community" ? Service.getContributor(gem.submittedBy) : null;
+            const badge = contributor ? Core.badgeForReputation(contributor.reputation, Data) : null;
+
+            const card = document.createElement("div");
+            card.className = "gem-card glass-card";
+            card.innerHTML = `
+                <img src="${escapeHtml(gem.img || "https://picsum.photos/seed/" + encodeURIComponent(gem.id) + "/600/400")}" alt="${escapeHtml(gem.name)}, ${escapeHtml(gem.state || "")}" loading="lazy">
+                <button class="gem-favorite" aria-label="${isBookmarked ? "Remove " + escapeHtml(gem.name) + " from bookmarks" : "Bookmark " + escapeHtml(gem.name)}" aria-pressed="${isBookmarked}" data-action="bookmark" data-gem-id="${gem.id}">${isBookmarked ? "❤️" : "♡"}</button>
+                <span class="gem-category-badge">${cat.icon} ${escapeHtml(cat.label)}</span>
+                <div class="gem-info">
+                    <h3>${escapeHtml(gem.name)}</h3>
+                    <p class="region">${escapeHtml(gem.state || "")}</p>
+                    <p>${escapeHtml(gem.desc || "")}</p>
+                    <div class="gem-meta-row">
+                        <button class="gem-upvote-btn ${isUpvoted ? "active" : ""}" data-action="upvote" data-gem-id="${gem.id}">▲ ${gem.upvotes || 0}</button>
+                        <button class="gem-report-btn" data-action="report" data-gem-id="${gem.id}" title="Report this gem">⚑ Report</button>
+                        ${contributor ? `<span class="gem-contributor">${badge.icon} ${escapeHtml(contributor.name)}</span>` : `<span class="gem-contributor">Editorial pick</span>`}
+                    </div>
+                </div>
+            `;
+            return card;
+        }
+
+        function renderGems() {
+            const data = getFilteredGems();
+            grid.innerHTML = "";
+            if (emptyState) emptyState.classList.toggle("visible", data.length === 0);
+            data.forEach((gem) => grid.appendChild(renderGemCard(gem)));
+            wireGemActions(grid);
+        }
+
+        function renderTrending() {
+            if (!trendingGrid) return;
+            const published = Service.getPublishedGems(Data);
+            const top = Core.trendingGems(published, Data, 6);
+            trendingGrid.innerHTML = "";
+            if (!top.length) {
+                trendingGrid.innerHTML = "<p class='gems-empty-state visible'>No trending gems yet — upvote your favorites!</p>";
+                return;
+            }
+            top.forEach((gem) => trendingGrid.appendChild(renderGemCard(gem)));
+            wireGemActions(trendingGrid);
+        }
+
+        function renderLeaderboard() {
+            if (!leaderboardList) return;
+            const top = Service.getLeaderboard(Core, Data, 8);
+            if (!top.length) {
+                leaderboardList.innerHTML = "<li class='leaderboard-empty'>No contributors yet — be the first to submit a hidden gem!</li>";
+                return;
+            }
+            leaderboardList.innerHTML = top.map((c, i) => `
+                <li>
+                    <span class="leaderboard-rank">#${i + 1}</span>
+                    <span class="leaderboard-badge">${c.badge.icon}</span>
+                    <span class="leaderboard-name">${escapeHtml(c.name)}</span>
+                    <span class="leaderboard-stats">${c.reputation} pts · ${c.submissionCount} submission${c.submissionCount === 1 ? "" : "s"}</span>
+                </li>
+            `).join("");
+        }
+
+        function wireGemActions(container) {
+            container.querySelectorAll("[data-action='bookmark']").forEach((btn) => {
+                btn.addEventListener("click", () => {
+                    const gemId = btn.dataset.gemId;
+                    const nowBookmarked = Service.toggleBookmark(gemId);
+                    btn.textContent = nowBookmarked ? "❤️" : "♡";
+                    btn.setAttribute("aria-pressed", String(nowBookmarked));
+                });
+            });
+            container.querySelectorAll("[data-action='upvote']").forEach((btn) => {
+                btn.addEventListener("click", () => {
+                    const gemId = btn.dataset.gemId;
+                    const result = Service.toggleUpvote(gemId, Core, Data);
+                    btn.textContent = `▲ ${result.count}`;
+                    btn.classList.toggle("active", result.upvoted);
+                    renderTrending();
+                    renderLeaderboard();
+                });
+            });
+            container.querySelectorAll("[data-action='report']").forEach((btn) => {
+                btn.addEventListener("click", () => {
+                    const gemId = btn.dataset.gemId;
+                    const reason = window.prompt("Why are you reporting this hidden gem? (e.g. inaccurate, inappropriate, duplicate)");
+                    if (reason && reason.trim()) {
+                        Service.reportGem(gemId, reason.trim());
+                        window.alert("Thanks — this has been flagged for a moderator to review.");
+                    }
+                });
+            });
+        }
+
+        // -- Filters & search -------------------------------------------------
+        filterButtons.forEach((btn) => {
+            btn.addEventListener("click", () => {
+                filterButtons.forEach((b) => { b.classList.remove("active"); b.setAttribute("aria-pressed", "false"); });
+                btn.classList.add("active");
+                btn.setAttribute("aria-pressed", "true");
+                currentRegion = btn.dataset.region;
+                renderGems();
+            });
+        });
+        if (searchInput) {
+            searchInput.addEventListener("input", (e) => {
+                currentSearch = e.target.value;
+                renderGems();
+            });
+        }
+
+        // -- Submission form ---------------------------------------------------
+        if (form) {
+            form.addEventListener("submit", (e) => {
+                e.preventDefault();
+                const fd = new FormData(form);
+                const lat = parseFloat(fd.get("lat"));
+                const lng = parseFloat(fd.get("lng"));
+
+                const submissionInput = {
+                    name: (fd.get("name") || "").toString().trim(),
+                    desc: (fd.get("desc") || "").toString().trim(),
+                    img: (fd.get("img") || "").toString().trim(),
+                    category: (fd.get("category") || "").toString(),
+                    state: (fd.get("state") || "").toString().trim(),
+                    region: (fd.get("region") || "").toString(),
+                    lat: Number.isNaN(lat) ? undefined : lat,
+                    lng: Number.isNaN(lng) ? undefined : lng,
+                    submittedBy: (fd.get("submittedBy") || "").toString().trim() || "Anonymous Explorer"
+                };
+
+                if (!submissionInput.name || !submissionInput.desc || !submissionInput.region) {
+                    renderSubmitResult({ error: "Please fill in at least a name, description, and region." });
+                    return;
+                }
+
+                const { submission, qualityResult, duplicates } = Service.submitGem(submissionInput, Core, Data);
+                renderSubmitResult({ submission, qualityResult, duplicates });
+                form.reset();
+                if (moderatorToggleBtn && Service.isModeratorMode()) renderModerationQueue();
+            });
+        }
+
+        function renderSubmitResult({ submission, qualityResult, duplicates, error }) {
+            if (!submitResultPanel) return;
+            submitResultPanel.hidden = false;
+
+            if (error) {
+                submitResultPanel.innerHTML = `<p class="gem-submit-error">${escapeHtml(error)}</p>`;
+                return;
+            }
+
+            const dupHtml = duplicates.length
+                ? `<div class="gem-submit-warning">⚠️ This looks similar to <strong>${escapeHtml(duplicates[0].gem.name)}</strong> already in the database (${Math.round(duplicates[0].similarity * 100)}% text match${duplicates[0].distanceKm !== null ? `, ${duplicates[0].distanceKm} km away` : ""}). A moderator will double-check before approving.</div>`
+                : "";
+
+            const lowQuality = Core.isLowQuality(qualityResult);
+
+            submitResultPanel.innerHTML = `
+                <h4>Thanks, ${escapeHtml(submission.submittedBy)}! Your submission is pending review.</h4>
+                <div class="gem-quality-score">AI content-quality score: <strong>${qualityResult.score}/100</strong>${lowQuality ? " — flagged as low quality for extra moderator attention" : ""}</div>
+                ${qualityResult.flags.length ? `<ul class="gem-quality-flags">${qualityResult.flags.map((f) => `<li>${escapeHtml(flagLabel(f))}</li>`).join("")}</ul>` : ""}
+                ${dupHtml}
+                <p class="gem-submit-note">A moderator will approve, reject, or request changes. You'll gain reputation once it's approved.</p>
+            `;
+        }
+
+        function flagLabel(flag) {
+            const labels = {
+                "description-too-short": "Consider adding more detail to your description",
+                "missing-image": "No image URL provided",
+                "missing-coordinates": "No precise location (lat/lng) provided",
+                "missing-category": "No category selected",
+                "title-needs-review": "Title may need a human look (length/formatting)",
+                "prohibited-or-placeholder-content": "Contains prohibited or placeholder-like text"
+            };
+            return labels[flag] || flag;
+        }
+
+        // -- Moderation dashboard --------------------------------------------
+        if (moderatorToggleBtn && moderationSection) {
+            const applyModeratorVisibility = () => {
+                const on = Service.isModeratorMode();
+                moderationSection.hidden = !on;
+                moderatorToggleBtn.textContent = on ? "🛡️ Exit Moderator Mode" : "🛡️ Moderator Mode";
+                moderatorToggleBtn.setAttribute("aria-pressed", String(on));
+                if (on) renderModerationQueue();
+            };
+            moderatorToggleBtn.addEventListener("click", () => {
+                Service.setModeratorMode(!Service.isModeratorMode());
+                applyModeratorVisibility();
+            });
+            applyModeratorVisibility();
+        }
+
+        function renderModerationQueue() {
+            if (!moderationQueue) return;
+            const pending = Service.getAllSubmissions().filter((s) =>
+                s.status === Data.SUBMISSION_STATUS.PENDING || s.status === Data.SUBMISSION_STATUS.CHANGES_REQUESTED
+            );
+
+            if (!pending.length) {
+                moderationQueue.innerHTML = "<p>No submissions waiting for review.</p>";
+                return;
+            }
+
+            moderationQueue.innerHTML = pending.map((s) => {
+                const dup = s.duplicateOf ? Service.getAllGemsForDuplicateCheck(Data).find((g) => g.id === s.duplicateOf) : null;
+                return `
+                <div class="moderation-card" data-submission-id="${s.id}">
+                    <div class="moderation-card-header">
+                        <h5>${escapeHtml(s.name)} <span class="moderation-status moderation-status-${s.status}">${escapeHtml(s.status.replace("_", " "))}</span></h5>
+                        <span>by ${escapeHtml(s.submittedBy)} · quality ${s.qualityScore}/100${dup ? ` · possible duplicate of ${escapeHtml(dup.name)}` : ""}</span>
+                    </div>
+                    <p>${escapeHtml(s.desc)}</p>
+                    ${s.qualityFlags && s.qualityFlags.length ? `<p class="moderation-flags">Flags: ${s.qualityFlags.map(flagLabel).map(escapeHtml).join(", ")}</p>` : ""}
+                    <div class="moderation-actions">
+                        <button data-mod-action="approved">✅ Approve</button>
+                        <button data-mod-action="changes_requested">✏️ Request Changes</button>
+                        <button data-mod-action="rejected">❌ Reject</button>
+                    </div>
+                </div>`;
+            }).join("");
+
+            moderationQueue.querySelectorAll("[data-mod-action]").forEach((btn) => {
+                btn.addEventListener("click", () => {
+                    const card = btn.closest("[data-submission-id]");
+                    const id = card.dataset.submissionId;
+                    const nextStatus = btn.dataset.modAction;
+                    let note = null;
+                    if (nextStatus === "changes_requested" || nextStatus === "rejected") {
+                        note = window.prompt("Add a note for the contributor (optional):") || "";
+                    }
+                    Service.moderateSubmission(id, nextStatus, note, Core, Data);
+                    renderModerationQueue();
+                    renderGems();
+                    renderTrending();
+                    renderLeaderboard();
+                });
+            });
+        }
+
+        // -- Utilities -----------------------------------------------------
+        function escapeHtml(str) {
+            return String(str).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
+        }
+
+        // -- Initial render --------------------------------------------------
+        renderGems();
+        renderTrending();
+        renderLeaderboard();
+    }
+
+    window.initHiddenGemsPage = initHiddenGemsPage;
+
+    if (typeof module !== "undefined" && module.exports) {
+        module.exports = { initHiddenGemsPage };
+    }
+})();
