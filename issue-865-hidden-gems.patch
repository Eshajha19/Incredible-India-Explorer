+/* ==========================================================================
+   HIDDEN GEMS PAGE — community platform additions
+   ========================================================================== */
+
+.gem-category-badge {
+    position: absolute;
+    top: 15px;
+    left: 15px;
+    background: rgba(9, 13, 22, 0.75);
+    color: var(--text-light, #fff);
+    padding: 6px 12px;
+    border-radius: 999px;
+    font-size: 0.8rem;
+    z-index: 10;
+}
+
+.gem-meta-row {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    margin-top: 12px;
+    flex-wrap: wrap;
+}
+
+.gem-upvote-btn,
+.gem-report-btn {
+    background: transparent;
+    border: 1px solid rgba(255, 255, 255, 0.15);
+    color: inherit;
+    border-radius: 999px;
+    padding: 6px 12px;
+    cursor: pointer;
+    font-size: 0.85rem;
+}
+
+.gem-upvote-btn.active {
+    background: var(--primary-gold);
+    color: #000;
+    border-color: var(--primary-gold);
+}
+
+.gem-contributor {
+    margin-left: auto;
+    font-size: 0.8rem;
+    opacity: 0.7;
+}
+
+/* -- Submission form -------------------------------------------------- */
+.gem-submit-card {
+    max-width: 700px;
+    margin: 0 auto;
+    padding: 32px;
+}
+
+.gem-submit-card .form-row {
+    margin-bottom: 16px;
+}
+
+.gem-submit-card label {
+    display: block;
+    font-weight: 600;
+    margin-bottom: 6px;
+}
+
+.gem-submit-card input,
+.gem-submit-card select,
+.gem-submit-card textarea {
+    width: 100%;
+    padding: 12px 14px;
+    border-radius: 10px;
+    border: 1px solid rgba(255, 255, 255, 0.12);
+    background: rgba(255, 255, 255, 0.05);
+    color: inherit;
+    font-family: inherit;
+    font-size: 1rem;
+}
+
+.gem-submit-card textarea {
+    min-height: 100px;
+    resize: vertical;
+}
+
+.gem-submit-card .form-row-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
+    gap: 16px;
+}
+
+.gem-submit-result {
+    max-width: 700px;
+    margin: 24px auto 0;
+    padding: 24px;
+    border-radius: 16px;
+    background: rgba(255, 255, 255, 0.04);
+    border: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+.gem-quality-score {
+    margin: 10px 0;
+    font-size: 1.05rem;
+}
+
+.gem-quality-flags {
+    margin: 8px 0 12px 20px;
+    opacity: 0.8;
+    font-size: 0.9rem;
+}
+
+.gem-submit-warning {
+    background: rgba(249, 168, 37, 0.12);
+    border-left: 3px solid #f9a825;
+    padding: 10px 14px;
+    border-radius: 8px;
+    margin: 12px 0;
+}
+
+.gem-submit-error {
+    color: #ef5350;
+}
+
+.gem-submit-note {
+    opacity: 0.75;
+    font-size: 0.9rem;
+}
+
+/* -- Moderator toggle & dashboard --------------------------------------- */
+.moderator-toggle-row {
+    text-align: center;
+    margin-bottom: 20px;
+}
+
+#moderatorModeToggle {
+    padding: 10px 22px;
+    border-radius: 999px;
+    border: 2px solid var(--primary-gold);
+    background: transparent;
+    color: var(--primary-gold);
+    cursor: pointer;
+    font-weight: 600;
+}
+
+#moderatorModeToggle[aria-pressed="true"] {
+    background: var(--primary-gold);
+    color: #000;
+}
+
+.moderation-card {
+    background: rgba(255, 255, 255, 0.04);
+    border: 1px solid rgba(255, 255, 255, 0.08);
+    border-radius: 14px;
+    padding: 18px 20px;
+    margin-bottom: 16px;
+}
+
+.moderation-card-header {
+    display: flex;
+    justify-content: space-between;
+    align-items: baseline;
+    flex-wrap: wrap;
+    gap: 8px;
+    margin-bottom: 8px;
+}
+
+.moderation-status {
+    font-size: 0.75rem;
+    padding: 2px 10px;
+    border-radius: 999px;
+    margin-left: 8px;
+    text-transform: capitalize;
+    background: rgba(255, 255, 255, 0.1);
+}
+
+.moderation-flags {
+    font-size: 0.85rem;
+    opacity: 0.75;
+}
+
+.moderation-actions {
+    display: flex;
+    gap: 10px;
+    margin-top: 12px;
+    flex-wrap: wrap;
+}
+
+.moderation-actions button {
+    padding: 8px 16px;
+    border-radius: 8px;
+    border: 1px solid rgba(255, 255, 255, 0.15);
+    background: rgba(255, 255, 255, 0.06);
+    color: inherit;
+    cursor: pointer;
+}
+
+/* -- Leaderboard ---------------------------------------------------------- */
+#leaderboardList {
+    list-style: none;
+    padding: 0;
+    max-width: 600px;
+    margin: 0 auto;
+}
+
+#leaderboardList li {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    padding: 10px 16px;
+    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
+}
+
+.leaderboard-rank {
+    font-weight: 700;
+    opacity: 0.6;
+    width: 32px;
+}
+
+.leaderboard-name {
+    font-weight: 600;
+    flex: 1;
+}
+
+.leaderboard-stats {
+    opacity: 0.7;
+    font-size: 0.85rem;
+}
